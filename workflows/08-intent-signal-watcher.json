      "id": "0b0e8a40-bffe-6641-fb72-f54eefaa679e",
      "name": "Signal Found?"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1960,
        120
      ],
      "id": "7d9e2daf-95d6-6579-68ad-aa7814499112",
      "name": "No Signal"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fold the signal score into the lead so 05 does not have to know about signals.\nreturn $input.all().map((item) => ({ json: Object.assign({}, item.json, {\n  lead: {\n    domain: item.json.domain,\n    company: item.json.company,\n    viewed_competitor_page: false,\n    signal_score: item.json.signal_score,\n    signal_keys: item.json.matched.map((m) => m.key),\n    source: 'intent_signal'\n  }\n}) }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        290
      ],
      "id": "ece5439b-e739-e9d4-9b4a-27bdb3fed747",
      "name": "Score Signal"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BASE_URL }}/leads/tag",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "retry": {
            "retry": {
              "maxTries": 2,
              "waitBetweenTries": 2000
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ match: { domain: $json.lead.domain }, tags: $json.lead.signal_keys.map((k) => 'signal:' + k), signal_score: $json.lead.signal_score }) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        120
      ],
      "id": "f77a42f8-054e-71a8-dd3f-9d27f244f658",
      "name": "Tag Lead In CRM",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CRM_CREDENTIAL_ID",
          "name": "Crm header auth"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=Buying signal on {{ $json.lead.company || $json.lead.domain }}: {{ $json.lead.signal_keys.join(', ') }} (score {{ $json.lead.signal_score }})",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        2480,
        120
      ],
      "id": "d50ade64-ad0d-af60-56d3-e04f2883907a",
      "name": "Alert Sales",
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack workspace"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO intent_signals (domain, signal_keys, signal_score, detected_at)\nVALUES (lower('{{ $json.lead.domain }}'), '{{ JSON.stringify($json.lead.signal_keys) }}'::jsonb,\n        {{ $json.lead.signal_score }}, NOW());\nUPDATE watchlist SET last_scanned_at = NOW() WHERE domain = lower('{{ $json.lead.domain }}');",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2740,
