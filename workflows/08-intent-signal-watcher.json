{
  "name": "08-intent-signal-watcher Intent Signal Watcher",
  "nodes": [
    {
      "parameters": {
        "content": "## 08 Intent Signal Watcher\n\nWatches a company watchlist for hiring, funding, tech and leadership signals and tags the CRM.\n\n**Safety rails:** Calls 16-safety-rails before any outbound action.\n\n**Before you enable this:** replace every REPLACE_WITH_* value, point CRM_BASE_URL/CRM_ADAPTER at your CRM, and run it once manually with test data.\n\nDocs: README.md, docs/SETUP.md, docs/COMPLIANCE.md",
        "width": 400,
        "height": 420,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -560,
        60
      ],
      "id": "6e73b941-9a26-7514-ed22-23e66bd09b72",
      "name": "Read Me"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 360
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -120,
        120
      ],
      "id": "6ce2ed81-466b-9f8d-cf0e-269a3308d63a",
      "name": "Every 6 Hours"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, domain, company, lead_id, last_scanned_at\nFROM watchlist\nWHERE active = true\n  AND (last_scanned_at IS NULL OR last_scanned_at < NOW() - INTERVAL '6 hours')\nORDER BY last_scanned_at NULLS FIRST\nLIMIT 50;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        140,
        120
      ],
      "id": "e1e45ed3-e381-afb8-b5c4-8f1587d1793b",
      "name": "Load Watchlist",
      "notes": "A watchlist, not the open internet. Scanning everything is how you burn credits.",
      "notesInFlow": false,
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Leadgen Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build the request the rails expect. Missing fields are denied, not defaulted:\n// the rails fail closed on purpose.\nreturn $input.all().map((item) => {\n  const lead = item.json.lead || item.json;\n  return { json: Object.assign({}, item.json, { rails_request: {\n    channel: 'system',\n    purpose: 'signal_scan',\n    contact_email: lead.email || '',\n    contact_phone: lead.phone || '',\n    contact_handle: lead.handle || '',\n    inbound_message: lead.last_inbound_message || '',\n    consent: { basis: lead.consent_basis || null, recorded_at: lead.consent_recorded_at || null },\n    estimated_cost_usd: Number(lead.estimated_cost_usd || 0),\n    workflow: $workflow.name\n  } }) };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        120
      ],
      "id": "227a17f0-8bc2-0b3c-d00f-face2050702c",
      "name": "Build Rails Request",
      "notes": "Neutral request shape consumed by 16-safety-rails.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_16_SAFETY_RAILS_WORKFLOW_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "payload": "={{ JSON.stringify($json.rails_request) }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        120
      ],
      "id": "00aed483-9224-803b-c79c-bf512e0cd2e6",
      "name": "Safety Rails",
      "notes": "Calls 16-safety-rails. Nothing that can reach a prospect runs before the rails return allowed=true.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "01c54d78-5356-6bfc-600a-34fcfa33d740",
              "leftValue": "={{ $json.allowed === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        120
      ],
      "id": "344a2e56-57f5-2e52-6547-6729491803c1",
      "name": "Rails Allowed?",
      "notes": "False branch is a dead end by design.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The rails said no. Record it and stop. A denied action is never retried.\nreturn $input.all().map((item) => ({ json: {\n  blocked: true,\n  code: item.json.code || 'denied',\n  reason: item.json.reason || 'Safety rails denied this action.',\n  contact: item.json.rails_request ? item.json.rails_request.contact_email : null,\n  workflow: $workflow.name,\n  at: new Date().toISOString()\n} }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        120
      ],
      "id": "724fe605-732d-9bd0-386b-3f94445d24f8",
      "name": "Log Blocked"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO touch_log (lead_id, workflow, channel, direction, detail, occurred_at)\nVALUES (NULL, '{{ $json.workflow }}', 'system', 'blocked',\n        jsonb_build_object('code', '{{ $json.code }}', 'reason', '{{ $json.reason }}'), NOW());",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        120
      ],
      "id": "22b711b6-6d7f-51e1-39b3-584a290520a3",
      "name": "Persist Block",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Leadgen Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SIGNALS_BASE_URL }}/company/signals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "retry": {
            "retry": {
              "maxTries": 2,
              "waitBetweenTries": 2000
            }
          }
        },
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "domain",
              "value": "={{ $json.domain }}"
            },
            {
              "name": "since",
              "value": "={{ $json.last_scanned_at || '' }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        290
      ],
      "id": "ac6486dd-8470-5ab1-c4c1-901b6834105d",
      "name": "Fetch Signals",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_SIGNALS_CREDENTIAL_ID",
          "name": "Signals header auth"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Signals we care about, in the order an agency actually cares about them.\nconst RULES = [\n  { key: 'hiring_relevant_role', weight: 25, test: (s) => /hiring|job|vacancy/i.test(s.type || '') && /marketing|growth|sales|operations/i.test(s.text || '') },\n  { key: 'funding_round', weight: 30, test: (s) => /funding|raised|seed|series/i.test((s.type || '') + ' ' + (s.text || '')) },\n  { key: 'tech_change', weight: 20, test: (s) => /tech|stack|migrated|installed/i.test(s.type || '') },\n  { key: 'new_location', weight: 15, test: (s) => /location|opened|expansion/i.test((s.type || '') + ' ' + (s.text || '')) },\n  { key: 'leadership_change', weight: 15, test: (s) => /appointed|new (ceo|cmo|head)/i.test(s.text || '') }\n];\nreturn $input.all().map((item) => {\n  const signals = Array.isArray(item.json.signals) ? item.json.signals : [];\n  const matched = [];\n  for (const s of signals) {\n    for (const r of RULES) {\n      try { if (r.test(s)) matched.push({ key: r.key, weight: r.weight, text: s.text || '', at: s.at || null }); }\n      catch (e) { /* a malformed signal is not a reason to fail the run */ }\n    }\n  }\n  const total = matched.reduce((sum, m) => sum + m.weight, 0);\n  return { json: Object.assign({}, item.json, { matched, signal_score: total, found: matched.length > 0 }) };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        290
      ],
      "id": "537f01e0-afe5-123f-a454-274fd6d02a38",
      "name": "Detect Buying Signals"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a044bc0b-7e6a-7f1d-a3dd-85d1965d82be",
              "leftValue": "={{ $json.found === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
