      "id": "54bea744-b372-b8d8-f60c-10aa6fcc5ac0",
      "name": "Skip Enrichment",
      "notes": "Provider 'none' - the pack still works, leads just score on form data.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Every provider returns a different shape. Normalise to one contract so the\n// scoring rubric never learns a vendor's field names.\nfunction firstOf(obj, paths) {\n  for (const p of paths) {\n    const v = p.split('.').reduce((acc, k) => (acc && acc[k] !== undefined ? acc[k] : undefined), obj);\n    if (v !== undefined && v !== null && v !== '') return v;\n  }\n  return null;\n}\nreturn $input.all().map((item) => {\n  const raw = item.json;\n  const enrichment = {\n    company: firstOf(raw, ['name', 'company.name', 'organization.name']),\n    domain: firstOf(raw, ['domain', 'company.domain', 'website']),\n    company_size: Number(firstOf(raw, ['employees', 'metrics.employees', 'company.employeesRange']) || 0) || null,\n    industry: firstOf(raw, ['industry', 'category.industry', 'company.industry']),\n    country: firstOf(raw, ['country', 'geo.country', 'location.country']),\n    tech: firstOf(raw, ['tech', 'technologies', 'tech_stack']) || [],\n    socials: {\n      linkedin: firstOf(raw, ['linkedin.handle', 'socials.linkedin']),\n      instagram: firstOf(raw, ['instagram.handle', 'socials.instagram'])\n    },\n    provider: $('Provider Config').first().json.provider,\n    fetched_at: new Date().toISOString()\n  };\n  const usable = Boolean(enrichment.company || enrichment.company_size || enrichment.industry);\n  return { json: { enrichment, cached: false, usable, cost_usd: usable ? $('Provider Config').first().json.cost_per_lookup_usd : 0 } };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        120
      ],
      "id": "8beef91b-ad96-a740-b2b8-3221a1d70876",
      "name": "Normalize Provider Response"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO enrichment_cache (domain, payload, provider, fetched_at)\nVALUES (lower('{{ $json.enrichment.domain }}'), '{{ JSON.stringify($json.enrichment) }}'::jsonb,\n        '{{ $json.enrichment.provider }}', NOW())\nON CONFLICT (domain) DO UPDATE SET payload = EXCLUDED.payload, fetched_at = NOW();",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1700,
        120
      ],
      "id": "9126e537-2018-5ad4-98a4-8ba30e2b9ed4",
      "name": "Write Cache",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Leadgen Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO spend_ledger (workflow, item, amount_usd, occurred_at)\nVALUES ('06-domain-enrichment', 'enrichment_lookup', {{ $json.cost_usd }}, NOW());",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1960,
        120
      ],
      "id": "93dd9071-5c40-c448-cb3a-809dfb4a474b",
      "name": "Record Provider Spend",
      "notes": "This is what the rails read when they enforce the daily spend cap.",
      "notesInFlow": false,
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Leadgen Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map((item) => ({ json: {\n  enrichment: item.json.enrichment || null,\n  cached: Boolean(item.json.cached),\n  cost_usd: Number(item.json.cost_usd || 0)\n} }));\n"
      },
