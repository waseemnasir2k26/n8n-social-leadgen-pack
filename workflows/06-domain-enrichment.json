        "operation": "executeQuery",
        "query": "=SELECT payload, fetched_at FROM enrichment_cache\nWHERE domain = lower('{{ $json.domain }}')\n  AND fetched_at > NOW() - INTERVAL '{{ $json.cache_days }} days'\nLIMIT 1;",
